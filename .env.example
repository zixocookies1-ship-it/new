# ------------------------------------------------------------------------------
#  Nature's Choice Jaggery — environment template
#
#  Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not.
#
#  Every integration below is OPTIONAL in the sense that the app boots without
#  it — but the storefront will refuse to claim a capability that is not really
#  connected. Nothing here is a mock: if a key is missing, the corresponding
#  feature stays switched off and says so.
#
#  Generate AUTH_SECRET with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────────────────

# MongoDB. Local: mongodb://127.0.0.1:27017/natures_choice
# Atlas:    mongodb+srv://USER:PASSWORD@cluster0.abcde.mongodb.net/natures_choice?retryWrites=true&w=majority
MONGODB_URI=

# Signs admin session cookies (HS256). MUST be at least 32 random characters.
# Without it, admin login is disabled entirely and /admin/login explains why.
AUTH_SECRET=

# ── Public site URL ───────────────────────────────────────────────────────────
# Used for canonical tags, Open Graph URLs, the sitemap and robots.txt.
# No trailing slash. Must be the real origin in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cloudinary (image delivery + admin uploads) ───────────────────────────────
# Only URLs are stored in MongoDB. Image bytes never enter the database.
# Leave blank and the storefront renders neutral placeholders instead of images.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional. Only needed if you use a non-standard delivery host; the default
# res.cloudinary.com works with CLOUDINARY_CLOUD_NAME alone.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── Razorpay (online payments) ────────────────────────────────────────────────
# Test keys from https://dashboard.razorpay.com/app/keys
# The server NEVER trusts the browser's success callback: it verifies the HMAC
# signature and re-fetches the payment from Razorpay before marking an order paid.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Safe to expose in the browser — this is the publishable key used by Checkout.js.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional but strongly recommended. Without it the webhook endpoint rejects
# every event, so a payment captured outside the browser window stays pending
# until an admin retries from the Orders screen.
# Razorpay Dashboard → Settings → Webhooks → add
#   https://your-domain.com/api/payments/webhook
#   events: payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# ── Delhivery (shipping + live tracking) ──────────────────────────────────────
# Pickup address itself lives in Admin → Shipping, not here.
DELHIVERY_API_KEY=
DELHIVERY_BASE_URL=https://api.delhivery.com

# Optional: create the shipment automatically as soon as a payment is captured.
# With this off you approve each shipment from Admin → Orders.
DELHIVERY_AUTO_CREATE=true

# Optional: poll Delhivery for status changes on a schedule. Off by default
# because a naive cron will quietly burn API quota.
DELHIVERY_AUTO_STATUS_SYNC=false

# Optional fallback origin, used only when the admin pickup address is incomplete.
DELHIVERY_DEFAULT_PINCODE=
DELHIVERY_DEFAULT_CITY=
DELHIVERY_DEFAULT_STATE=
DELHIVERY_DEFAULT_COUNTRY=India

# Optional: Google Search Console verification meta tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Admin bootstrap (optional convenience) ────────────────────────────────────
# Only used by `npm run seed:admin` when --email/--password are not passed.
# Strongly recommended: use `npm run seed:admin` without --password so the
# secret is never typed into shell history, then remove these two lines.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Internal ──────────────────────────────────────────────────────────────────
# Shared secret for first-party server-to-server calls. Leave blank to disable.
INTERNAL_API_KEY=

# Cache TTL for read-through config caches, in seconds. Default 300.
CACHE_TTL_SECONDS=300